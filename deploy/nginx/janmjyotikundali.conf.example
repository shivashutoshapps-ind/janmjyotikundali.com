# Nginx Configuration Example for JanmJyoti
# Place this file in /etc/nginx/sites-available/janmjyotikundali.conf
# and symlink to /etc/nginx/sites-enabled/

server {
    listen 80;
    listen [::]:80;
    server_name janmjyotikundali.com www.janmjyotikundali.com;

    # Redirect HTTP to HTTPS (uncomment once SSL is configured via Certbot)
    # return 301 https://$host$request_uri;
}

